# /etc/sudoers.d/azagent  (install with: sudo visudo -f /etc/sudoers.d/azagent)
# The Azure DevOps agent gets only the rights needed for deployment.
# Replace "azagent" with the user that runs the agent.

azagent ALL=(root) NOPASSWD: /usr/bin/rsync, \
  /usr/bin/mkdir, \
  /usr/bin/chown, \
  /usr/bin/npm, \
  /usr/bin/systemctl restart milo-api, \
  /usr/bin/systemctl reload nginx, \
  /usr/bin/systemctl is-active --quiet milo-api, \
  /usr/sbin/nginx -t, \
  /usr/bin/journalctl -u milo-api *
