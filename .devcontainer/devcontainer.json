{
  "name": "Milo Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5273, 3001],
  "portsAttributes": {
    "5273": { "label": "Frontend (Vite)" },
    "3001": { "label": "API (Express)" }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "alexcvzz.vscode-sqlite"
      ]
    }
  },
  "remoteUser": "node"
}
