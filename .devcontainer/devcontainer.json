{
  "name": "Milo Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Ports are published by Docker ("docker run -p") and not forwarded by
  // VS Code: its forwarding binds to 127.0.0.1 of the host machine, and
  // nothing from the local network can reach it — which an inventory agent,
  // running on another machine, precisely needs. The
  // "remote.localPortHost" setting that should lift this limit is not
  // honored for dev containers
  // (microsoft/vscode-remote-release#11131).
  //
  // Both processes already listen on all interfaces inside the
  // container: Vite through "host: true" (client/vite.config.ts), Express
  // because "listen" without a host does so by default.
  "appPort": ["5273:5273", "3001:3001"],
  "portsAttributes": {
    // "ignore" prevents VS Code from reopening a forward of its own on top:
    // since the host port is already taken by Docker, it would silently
    // fall back to the next port.
    "5273": { "label": "Frontend (Vite)", "onAutoForward": "ignore" },
    "3001": { "label": "API (Express)", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "alexcvzz.vscode-sqlite"
      ]
    }
  },
  "remoteUser": "node"
}
