# /etc/systemd/system/milo-api.service
[Unit]
Description=Milo API
After=network.target

[Service]
Type=simple
User=milo
Group=milo
WorkingDirectory=/opt/milo/server
Environment=NODE_ENV=production
Environment=PORT=3001
# La base vit hors du dossier déployé : un déploiement ne l'écrase jamais.
Environment=MILO_DB_PATH=/var/lib/milo/data.db
# Les fichiers déposés sur les cartes, pour la même raison : un déploiement
# remplace le code, il ne doit pas emporter les pièces jointes.
Environment=MILO_MEDIA_PATH=/var/lib/milo/medias
# Les images et pièces jointes des e-mails reçus au support.
Environment=MILO_TICKETS_PATH=/var/lib/milo/tickets
# Durée au bout de laquelle une session inutilisée se ferme, en jours.
Environment=MILO_SESSION_DAYS=30
# Aucune origine tierce : le client est servi par le même hôte que l'API, les
# appels sont relatifs et ne passent pas par CORS. À ne remplir que si le
# client venait à être servi ailleurs.
# Environment=MILO_CORS_ORIGINS=https://milo.example.fr
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=2

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/milo

[Install]
WantedBy=multi-user.target
