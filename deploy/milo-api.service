# /etc/systemd/system/milo-api.service
[Unit]
Description=Milo API
After=network.target

[Service]
Type=simple
User=milo
Group=milo
WorkingDirectory=/opt/milo/server
Environment=NODE_ENV=production
Environment=PORT=3001
# The database lives outside the deployed folder: a deployment never
Environment=MILO_DB_PATH=/var/lib/milo/data.db
# Files uploaded to cards, for the same reason: a deployment replaces the
# code, it must not wipe out the attachments.
Environment=MILO_MEDIA_PATH=/var/lib/milo/medias
# Images and attachments of emails received by support.
Environment=MILO_TICKETS_PATH=/var/lib/milo/tickets
# Idle time after which an unused session expires, in days.
Environment=MILO_SESSION_DAYS=30
# No third-party origin: the client is served by the same host as the API,
# calls are relative and do not go through CORS. Only fill in if the client
# were ever served elsewhere.
# Environment=MILO_CORS_ORIGINS=https://milo.example.fr
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/milo

[Install]
WantedBy=multi-user.target
