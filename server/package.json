{
  "name": "@milo/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput & node --watch --enable-source-maps dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@milo/shared": "*",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nodemailer": "^7.0.13",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.13.0"
  }
}
