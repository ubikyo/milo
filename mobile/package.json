{
  "name": "@milo/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Milo's iPhone and Android shells (Capacitor)",
  "scripts": {
    "sync": "node write-url.mjs && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "assets": "node make-assets.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#1f1f1f' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#1f1f1f'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.6.3"
  }
}
